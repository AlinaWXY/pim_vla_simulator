+import argparse
+import math
+import copy
+import numpy as np
+
+model = "gpt-3-175B"
+
+dhead = 128
+max_L = 2048
+data_size = 16 # FP 16
+
+n_attacc = 8
+max_n_hbm = 8
+n_hbm = 5
+n_channel = 16
