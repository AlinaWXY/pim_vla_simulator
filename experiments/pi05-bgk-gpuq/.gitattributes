* text=auto eol=lf
*.sh text eol=lf
*.sbatch text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.csv text eol=lf
# Preserve frozen reference bytes (CSV CRLF and matplotlib SVG whitespace).
# Generated artifacts retain their provenance hashes; source checks stay enabled.
reference/** -text -whitespace
verification/** -text
